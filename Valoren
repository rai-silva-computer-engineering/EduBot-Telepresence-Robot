    const STORAGE_ITEMS_KEY = 'valorem_items_v2';
    const STORAGE_RESERVATIONS_KEY = 'valorem_reservations_v2';

    let items = JSON.parse(localStorage.getItem(STORAGE_ITEMS_KEY)) || buildInitialItems();
    let reservations = JSON.parse(localStorage.getItem(STORAGE_RESERVATIONS_KEY)) || [];
    let selectedItemId = null;

    function saveState() {
      localStorage.setItem(STORAGE_ITEMS_KEY, JSON.stringify(items));
      localStorage.setItem(STORAGE_RESERVATIONS_KEY, JSON.stringify(reservations));
      updateReservationBadge();
    }

    function resetDemoData() {
      items = buildInitialItems();
      reservations = [];
      saveState();
      renderVitrine();
      renderReservas();
      renderImpacto();
      alert('Os dados de demonstração foram restaurados com datas atualizadas.');
    }

    // ==================== NAVEGAÇÃO ENTRE ABAS ====================
    function switchTab(tabName) {
      const views = ['vitrine', 'cadastrar', 'reservas', 'impacto'];
      views.forEach(v => {
        document.getElementById(`view-${v}`).classList.add('hidden');
        const btn = document.getElementById(`tab-${v}`);
        btn.classList.remove('bg-emerald-500', 'text-emerald-950', 'shadow');
        btn.classList.add('text-emerald-100', 'hover:bg-emerald-800/70');
      });

      document.getElementById(`view-${tabName}`).classList.remove('hidden');
      const activeBtn = document.getElementById(`tab-${tabName}`);
      activeBtn.classList.remove('text-emerald-100', 'hover:bg-emerald-800/70');
      activeBtn.classList.add('bg-emerald-500', 'text-emerald-950', 'shadow');

      if (tabName === 'vitrine') renderVitrine();
      if (tabName === 'reservas') renderReservas();
      if (tabName === 'impacto') renderImpacto();
    }

    function updateReservationBadge() {
      document.getElementById('badgeReservas').textContent = reservations.length;
    }

    // ==================== RENDERIZAR VITRINE ====================
    function renderVitrine() {
      const grid = document.getElementById('vitrineGrid');
      const search = document.getElementById('searchInput').value.trim().toLowerCase();
      const modFilter = document.getElementById('filterModality').value;
      const catFilter = document.getElementById('filterCategory').value;

      const filtered = items.filter(item => {
        const matchesSearch =
          item.title.toLowerCase().includes(search) ||
          item.store.toLowerCase().includes(search) ||
          item.address.toLowerCase().includes(search);
        const matchesMod = modFilter === 'all' || item.modality === modFilter;
        const matchesCat = catFilter === 'all' || item.category === catFilter;
        return matchesSearch && matchesMod && matchesCat;
      });

      if (filtered.length === 0) {
        grid.innerHTML = `
          <div class="col-span-full bg-white border border-slate-200 rounded-2xl p-10 text-center">
            <p class="text-slate-600 font-semibold">Nenhum lote encontrado com os filtros selecionados.</p>
            <p class="text-xs text-slate-400 mt-1">Tente limpar a busca ou cadastrar um novo excedente na aba "Cadastrar Excedente".</p>
          </div>
        `;
        return;
      }

      grid.innerHTML = filtered.map(item => {
        const badge = getDeadlineBadge(item.deadlineDate, item.windowEnd);
        const isDoacao = item.modality === 'doacao';
        const discountPct = !isDoacao && item.originalPrice > 0
          ? Math.round(((item.originalPrice - item.socialPrice) / item.originalPrice) * 100)
          : 100;

        return `
          <article class="bg-white rounded-2xl border ${item.reserved ? 'border-slate-200 opacity-80' : 'border-slate-200 hover:border-emerald-400 hover:shadow-md'} transition flex flex-col justify-between overflow-hidden">
            <div class="p-5 space-y-4">
              <!-- Topo com badges -->
              <div class="flex flex-wrap items-center justify-between gap-2">
                <span class="text-xs font-bold px-2.5 py-1 rounded-lg bg-slate-100 text-slate-700">${item.category}</span>
                <span class="text-xs font-bold px-2.5 py-1 rounded-full border ${badge.classes}">
                  ${badge.text}
                </span>
              </div>

              <!-- Título e Estabelecimento -->
              <div>
                <h3 class="font-bold text-slate-900 text-base leading-snug">${item.title}</h3>
                <p class="text-xs font-semibold text-emerald-800 mt-1.5 flex items-center gap-1.5">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
                  ${item.store}
                </p>
                <p class="text-[11px] text-slate-500 mt-0.5">${item.address}</p>
              </div>

              <!-- Bloco de Datas e Janela -->
              <div class="bg-slate-50 rounded-xl p-3 border border-slate-200/80 space-y-1.5 text-xs">
                <div class="flex justify-between">
                  <span class="text-slate-500">Quantidade / Peso:</span>
                  <span class="font-bold text-slate-800">${item.weight} kg</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-slate-500">Data Limite Retirada:</span>
                  <span class="font-bold text-slate-900">Retirar até ${formatDateBR(item.deadlineDate)}</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-slate-500">Janela de Horário:</span>
                  <span class="font-semibold text-slate-800">${item.windowStart} às ${item.windowEnd}</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-slate-500">Validade do Produto:</span>
                  <span class="font-semibold text-emerald-800">${formatDateBR(item.expiryDate)}</span>
                </div>
              </div>
            </div>

            <!-- Rodapé Preço & Botão -->
            <div class="px-5 py-4 bg-slate-50/70 border-t border-slate-100 flex items-center justify-between gap-3">
              <div>
                ${isDoacao ? `
                  <span class="inline-block text-[11px] font-bold uppercase tracking-wider text-emerald-700 bg-emerald-100 px-2 py-0.5 rounded">Doação Gratuita</span>
                  <div class="text-lg font-extrabold text-emerald-700 mt-0.5">R$ 0,00</div>
                ` : `
                  <div class="flex items-center gap-1.5">
                    <span class="text-[11px] line-through text-slate-400">R$ ${item.originalPrice.toFixed(2).replace('.', ',')}</span>
                    <span class="text-[10px] font-bold bg-amber-100 text-amber-900 px-1.5 py-0.2 rounded">-${discountPct}%</span>
                  </div>
                  <div class="text-lg font-extrabold text-amber-700">R$ ${item.socialPrice.toFixed(2).replace('.', ',')}</div>
                `}
              </div>

              ${item.reserved ? `
                <span class="px-4 py-2.5 rounded-xl text-xs font-bold bg-slate-200 text-slate-600 cursor-not-allowed">
                  Lote Reservado
                </span>
              ` : `
                <button onclick="openReserveModal('${item.id}')" class="px-4 py-2.5 rounded-xl text-xs font-bold bg-emerald-600 hover:bg-emerald-700 text-white shadow-xs transition">
                  Reservar Lote
                </button>
              `}
            </div>
          </article>
        `;
      }).join('');
    }

    // ==================== CADASTRO DE EXCEDENTE ====================
    function togglePriceFields() {
      const modality = document.getElementById('cadModality').value;
      const box = document.getElementById('socialPriceBox');
      const origInput = document.getElementById('cadOriginalPrice');
      const socInput = document.getElementById('cadSocialPrice');

      if (modality === 'social') {
        box.classList.remove('hidden');
        origInput.required = true;
        socInput.required = true;
      } else {
        box.classList.add('hidden');
        origInput.required = false;
        socInput.required = false;
      }
    }

    function updateDiscountPreview() {
      const orig = parseFloat(document.getElementById('cadOriginalPrice').value) || 0;
      const soc = parseFloat(document.getElementById('cadSocialPrice').value) || 0;
      const badge = document.getElementById('discountPreview');
      if (orig > 0 && soc >= 0 && soc < orig) {
        const pct = Math.round(((orig - soc) / orig) * 100);
        badge.textContent = `Desconto: ${pct}%`;
      } else {
        badge.textContent = 'Desconto: 0%';
      }
    }

    function handleCreateItem(e) {
      e.preventDefault();
      const errBox = document.getElementById('cadErrorMsg');
      errBox.classList.add('hidden');

      const today = getTodayISO();
      const modality = document.getElementById('cadModality').value;
      const weight = parseFloat(document.getElementById('cadWeight').value);
      const originalPrice = modality === 'social'
        ? parseFloat(document.getElementById('cadOriginalPrice').value)
        : Math.round(weight * 5.5);
      const socialPrice = modality === 'social'
        ? parseFloat(document.getElementById('cadSocialPrice').value)
        : 0;
      const deadlineDate = document.getElementById('cadDeadlineDate').value;
      const expiryDate = document.getElementById('cadExpiryDate').value;
      const windowStart = document.getElementById('cadWindowStart').value;
      const windowEnd = document.getElementById('cadWindowEnd').value;

      if (deadlineDate < today) {
        errBox.textContent = 'A data limite para retirada não pode ser anterior à data de hoje.';
        errBox.classList.remove('hidden');
        return;
      }

      if (expiryDate < deadlineDate) {
        errBox.textContent = 'A data de validade do produto deve ser igual ou posterior à data limite de retirada.';
        errBox.classList.remove('hidden');
        return;
      }

      if (windowEnd <= windowStart) {
        errBox.textContent = 'O horário final da janela de retirada deve ser posterior ao horário inicial.';
        errBox.classList.remove('hidden');
        return;
      }

      if (modality === 'social' && socialPrice >= originalPrice) {
        errBox.textContent = 'O preço social deve ser menor que o valor original de mercado.';
        errBox.classList.remove('hidden');
        return;
      }

      const newItem = {
        id: 'item-' + Date.now(),
        title: document.getElementById('cadTitle').value.trim(),
        category: document.getElementById('cadCategory').value,
        store: document.getElementById('cadStore').value.trim(),
        address: document.getElementById('cadAddress').value.trim(),
        weight,
        modality,
        originalPrice,
        socialPrice,
        deadlineDate,
        windowStart,
        windowEnd,
        expiryDate,
        reserved: false
      };

      items.unshift(newItem);
      saveState();
      e.target.reset();
      initDefaultFormDates();
      togglePriceFields();
      switchTab('vitrine');
    }

    // ==================== MODAL DE RESERVA ====================
    function openReserveModal(itemId) {
      const item = items.find(i => i.id === itemId);
      if (!item) return;

      selectedItemId = itemId;
      const today = getTodayISO();
      const errBox = document.getElementById('resErrorMsg');
      errBox.classList.add('hidden');

      document.getElementById('modalItemSummary').innerHTML = `
        <div class="font-bold text-slate-900 text-sm">${item.title}</div>
        <div class="text-slate-600"><strong>Estabelecimento:</strong> ${item.store} (${item.address})</div>
        <div class="text-slate-600"><strong>Quantidade:</strong> ${item.weight} kg • <strong>Modalidade:</strong> ${item.modality === 'doacao' ? 'Doação Gratuita' : 'Preço Social (R$ ' + item.socialPrice.toFixed(2).replace('.', ',') + ')'}</div>
        <div class="mt-2 p-2 rounded-lg bg-amber-50 border border-amber-200 text-amber-950 font-semibold">
          Prazo limite da plataforma: até ${formatDateBR(item.deadlineDate)} às ${item.windowEnd} (Janela: ${item.windowStart} às ${item.windowEnd})
        </div>
      `;

      const dateInput = document.getElementById('resPickupDate');
      dateInput.min = today;
      dateInput.max = item.deadlineDate;
      dateInput.value = item.deadlineDate >= today ? item.deadlineDate : today;

      const timeInput = document.getElementById('resPickupTime');
      timeInput.value = item.windowStart;

      document.getElementById('reserveModal').classList.remove('hidden');
    }

    function closeReserveModal() {
      document.getElementById('reserveModal').classList.add('hidden');
      selectedItemId = null;
    }

    function handleConfirmReserve(e) {
      e.preventDefault();
      const item = items.find(i => i.id === selectedItemId);
      if (!item) return;

      const errBox = document.getElementById('resErrorMsg');
      errBox.classList.add('hidden');

      const today = getTodayISO();
      const pickupDate = document.getElementById('resPickupDate').value;
      const pickupTime = document.getElementById('resPickupTime').value;

      if (pickupDate < today || pickupDate > item.deadlineDate) {
        errBox.textContent = `A data prevista deve estar entre hoje (${formatDateBR(today)}) e a data limite (${formatDateBR(item.deadlineDate)}).`;
        errBox.classList.remove('hidden');
        return;
      }

      if (pickupTime < item.windowStart || pickupTime > item.windowEnd) {
        errBox.textContent = `O horário estimado deve estar dentro da janela do comércio (${item.windowStart} às ${item.windowEnd}).`;
        errBox.classList.remove('hidden');
        return;
      }

      const randomDigits = Math.floor(1000 + Math.random() * 9000);
      const voucherCode = `VLR-2026-${randomDigits}`;

      const reservation = {
        id: 'res-' + Date.now(),
        voucherCode,
        itemId: item.id,
        itemTitle: item.title,
        category: item.category,
        store: item.store,
        address: item.address,
        weight: item.weight,
        modality: item.modality,
        originalPrice: item.originalPrice,
        socialPrice: item.socialPrice,
        deadlineDate: item.deadlineDate,
        windowStart: item.windowStart,
        windowEnd: item.windowEnd,
        expiryDate: item.expiryDate,
        orgName: document.getElementById('resOrgName').value.trim(),
        orgDoc: document.getElementById('resOrgDoc').value.trim(),
        phone: document.getElementById('resPhone').value.trim(),
        person: document.getElementById('resPerson').value.trim(),
        pickupDate,
        pickupTime,
        status: 'aguardando'
      };

      item.reserved = true;
      reservations.unshift(reservation);
      saveState();

      e.target.reset();
      closeReserveModal();
      renderVitrine();
      openVoucherModal(reservation.id);
    }

    // ==================== COMPROVANTE (VOUCHER) ====================
    function openVoucherModal(resId) {
      const res = reservations.find(r => r.id === resId);
      if (!res) return;

      const badge = getDeadlineBadge(res.deadlineDate, res.windowEnd);
      document.getElementById('voucherCodeDisplay').textContent = res.voucherCode;

      document.getElementById('voucherBody').innerHTML = `
        <div class="flex flex-wrap items-center justify-between gap-2 bg-emerald-50 border border-emerald-200 p-3 rounded-xl">
          <span class="text-xs font-extrabold uppercase text-emerald-900">
            Status: ${res.status === 'concluida' ? 'Retirada Concluída' : 'Aguardando Retirada'}
          </span>
          <span class="text-xs font-bold px-2.5 py-0.5 rounded-full border ${badge.classes}">
            ${badge.text}
          </span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
          <div class="p-3 rounded-xl border border-slate-200">
            <span class="text-slate-400 uppercase font-bold block">Instituição Beneficiária</span>
            <strong class="text-slate-900 text-sm block mt-0.5">${res.orgName}</strong>
            <span class="text-slate-600 block">Doc: ${res.orgDoc}</span>
            <span class="text-slate-600 block">Resp.: ${res.person} (${res.phone})</span>
          </div>

          <div class="p-3 rounded-xl border border-slate-200">
            <span class="text-slate-400 uppercase font-bold block">Local de Retirada</span>
            <strong class="text-slate-900 text-sm block mt-0.5">${res.store}</strong>
            <span class="text-slate-600 block">${res.address}</span>
          </div>
        </div>

        <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 text-xs space-y-1.5">
          <div class="flex justify-between"><span class="text-slate-500">Lote Reservado:</span><strong class="text-slate-900 text-right">${res.itemTitle} (${res.weight} kg)</strong></div>
          <div class="flex justify-between"><span class="text-slate-500">Data Limite para Retirada:</span><strong class="text-red-700">Até ${formatDateBR(res.deadlineDate)}</strong></div>
          <div class="flex justify-between"><span class="text-slate-500">Janela de Horário:</span><strong class="text-slate-800">${res.windowStart} às ${res.windowEnd}</strong></div>
          <div class="flex justify-between"><span class="text-slate-500">Agendado pela Instituição:</span><strong class="text-emerald-800">${formatDateBR(res.pickupDate)} às ${res.pickupTime}</strong></div>
          <div class="flex justify-between"><span class="text-slate-500">Validade do Produto:</span><strong class="text-slate-800">${formatDateBR(res.expiryDate)}</strong></div>
          <div class="flex justify-between"><span class="text-slate-500">Valor a Pagar no Local:</span><strong class="text-slate-900">${res.modality === 'doacao' ? 'R$ 0,00 (Doação Gratuita)' : 'R$ ' + res.socialPrice.toFixed(2).replace('.', ',')}</strong></div>
        </div>
      `;

      document.getElementById('voucherModal').classList.remove('hidden');
    }

    function closeVoucherModal() {
      document.getElementById('voucherModal').classList.add('hidden');
    }

    // ==================== ABA MINHAS RESERVAS ====================
    function confirmPickup(resId) {
      const res = reservations.find(r => r.id === resId);
      if (!res) return;
      res.status = 'concluida';
      saveState();
      renderReservas();
      renderImpacto();
    }

    function renderReservas() {
      const container = document.getElementById('reservasList');

      if (reservations.length === 0) {
        container.innerHTML = `
          <div class="bg-white border border-slate-200 rounded-2xl p-10 text-center space-y-3">
            <p class="text-slate-700 font-bold">Nenhuma reserva realizada até o momento.</p>
            <p class="text-xs text-slate-500">Acesse a Vitrine de Alimentos e clique em "Reservar Lote" para gerar um comprovante de retirada.</p>
            <button onclick="switchTab('vitrine')" class="px-4 py-2 rounded-xl text-xs font-bold bg-emerald-600 text-white">Ir para Vitrine</button>
          </div>
        `;
        return;
      }

      container.innerHTML = reservations.map(res => {
        const badge = getDeadlineBadge(res.deadlineDate, res.windowEnd);
        const isDone = res.status === 'concluida';

        return `
          <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-xs flex flex-col lg:flex-row lg:items-center justify-between gap-4">
            <div class="space-y-2">
              <div class="flex flex-wrap items-center gap-2">
                <span class="font-mono text-xs font-extrabold bg-slate-900 text-white px-2.5 py-1 rounded-lg">${res.voucherCode}</span>
                <span class="text-xs font-bold px-2.5 py-1 rounded-full ${isDone ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-900'}">
                  ${isDone ? 'Retirada Concluída' : 'Aguardando Retirada'}
                </span>
                ${!isDone ? `<span class="text-xs font-bold px-2.5 py-1 rounded-full border ${badge.classes}">${badge.text}</span>` : ''}
              </div>

              <h3 class="font-bold text-slate-900 text-base">${res.itemTitle} (${res.weight} kg)</h3>
              <p class="text-xs text-slate-600"><strong>Instituição:</strong> ${res.orgName} • <strong>Estabelecimento:</strong> ${res.store}</p>

              <div class="flex flex-wrap gap-x-5 gap-y-1 text-xs text-slate-600 pt-1">
                <span><strong>Data Limite:</strong> Até ${formatDateBR(res.deadlineDate)}</span>
                <span><strong>Janela:</strong> ${res.windowStart} às ${res.windowEnd}</span>
                <span><strong>Agendado:</strong> ${formatDateBR(res.pickupDate)} às ${res.pickupTime}</span>
                <span><strong>Validade:</strong> ${formatDateBR(res.expiryDate)}</span>
              </div>
            </div>

            <div class="flex flex-wrap sm:flex-nowrap items-center gap-2.5 shrink-0">
              <button onclick="openVoucherModal('${res.id}')" class="px-4 py-2 rounded-xl text-xs font-bold border border-slate-300 hover:bg-slate-50 text-slate-700">
                Ver Comprovante
              </button>
              ${!isDone ? `
                <button onclick="confirmPickup('${res.id}')" class="px-4 py-2 rounded-xl text-xs font-bold bg-emerald-600 hover:bg-emerald-700 text-white shadow-xs">
                  Confirmar Retirada
                </button>
              ` : ''}
            </div>
          </div>
        `;
      }).join('');
    }

    // ==================== ABA PAINEL DE IMPACTO ====================
    function renderImpacto() {
      const reservedOrDone = items.filter(i => i.reserved);
      const baseHistoricalKg = 420; // Histórico piloto acumulado
      const currentKg = reservedOrDone.reduce((acc, i) => acc + i.weight, 0);
      const totalKg = baseHistoricalKg + currentKg;

      const totalMeals = Math.round(totalKg * 2); // Estimativa média de 500g por refeição completa
      const baseSavings = 2480;
      const currentSavings = reservedOrDone.reduce((acc, i) => acc + (i.originalPrice - i.socialPrice), 0);
      const totalSavings = baseSavings + currentSavings;
      const uniqueStores = new Set(items.map(i => i.store)).size;

      document.getElementById('kpiGrid').innerHTML = `
        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-xs">
          <span class="text-xs font-bold uppercase text-slate-400">Alimentos Salvos</span>
          <div class="text-3xl font-extrabold text-emerald-700 mt-1">${totalKg.toLocaleString('pt-BR')} kg</div>
          <p class="text-xs text-slate-500 mt-1">Evitados do descarte no varejo</p>
        </div>
        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-xs">
          <span class="text-xs font-bold uppercase text-slate-400">Refeições Viabilizadas</span>
          <div class="text-3xl font-extrabold text-sky-700 mt-1">${totalMeals.toLocaleString('pt-BR')}</div>
          <p class="text-xs text-slate-500 mt-1">Estimativa nutricional (ODS 2)</p>
        </div>
        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-xs">
          <span class="text-xs font-bold uppercase text-slate-400">Economia para ONGs</span>
          <div class="text-3xl font-extrabold text-amber-600 mt-1">R$ ${totalSavings.toLocaleString('pt-BR', { minimumFractionDigits: 2 })}</div>
          <p class="text-xs text-slate-500 mt-1">Diferença frente ao preço de mercado</p>
        </div>
        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-xs">
          <span class="text-xs font-bold uppercase text-slate-400">Comércios Conectados</span>
          <div class="text-3xl font-extrabold text-slate-800 mt-1">${uniqueStores}</div>
          <p class="text-xs text-slate-500 mt-1">Estabelecimentos ativos na rede</p>
        </div>
      `;

      const categories = ['Hortifrúti', 'Padaria', 'Mercearia', 'Laticínios'];
      const baseCatWeights = { 'Hortifrúti': 180, 'Padaria': 75, 'Mercearia': 110, 'Laticínios': 55 };

      const catTotals = categories.map(cat => {
        const dynamicWeight = reservedOrDone
          .filter(i => i.category === cat)
          .reduce((sum, i) => sum + i.weight, 0);
        return { name: cat, weight: baseCatWeights[cat] + dynamicWeight };
      });

      const maxWeight = Math.max(...catTotals.map(c => c.weight), 1);

      document.getElementById('categoryBars').innerHTML = catTotals.map(cat => {
        const pct = Math.round((cat.weight / maxWeight) * 100);
        return `
          <div>
            <div class="flex justify-between text-xs font-semibold mb-1">
              <span class="text-slate-700">${cat.name}</span>
              <span class="text-emerald-800 font-bold">${cat.weight} kg</span>
            </div>
            <div class="w-full bg-slate-100 rounded-full h-2.5 overflow-hidden">
              <div class="bg-emerald-600 h-2.5 rounded-full transition-all duration-500" style="width: ${pct}%"></div>
            </div>
          </div>
        `;
      }).join('');
    }

    // ==================== INICIALIZAÇÃO ====================
    function initDefaultFormDates() {
      const today = getTodayISO();
      const tomorrow = addDaysISO(1);
      const threeDays = addDaysISO(3);

      const deadlineInput = document.getElementById('cadDeadlineDate');
      const expiryInput = document.getElementById('cadExpiryDate');

      deadlineInput.min = today;
      deadlineInput.value = tomorrow;

      expiryInput.min = today;
      expiryInput.value = threeDays;
    }

    document.addEventListener('DOMContentLoaded', () => {
      document.getElementById('headerCurrentDate').textContent = `Data do sistema: ${formatDateBR(getTodayISO())}`;
      initDefaultFormDates();
      updateReservationBadge();
      renderVitrine();
    });
  </script>
</body>
</html>
