
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>VALOREM — Plataforma de Combate ao Desperdício Alimentício</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; }
    @media print {
      body * { visibility: hidden; }
      #voucherPrintArea, #voucherPrintArea * { visibility: visible; }
      #voucherPrintArea {
        position: fixed;
        left: 0;
        top: 0;
        width: 100%;
        padding: 24px;
        background: white;
      }
      .no-print { display: none !important; }
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col">

  <!-- Navbar -->
  <header class="bg-emerald-900 text-white shadow-lg sticky top-0 z-30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between py-4 gap-4">
        <div class="flex items-center gap-3">
          <div class="bg-emerald-500 text-emerald-950 p-2.5 rounded-xl font-extrabold shadow-inner">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m8.66-10h-1M4.34 12h-1m15.07 6.07-.7-.7M6.34 6.34l-.7-.7m12.02 0-.7.7M6.34 17.66l-.7.7M12 7a5 5 0 100 10 5 5 0 000-10z" />
            </svg>
          </div>
          <div>
            <div class="flex items-center gap-2">
              <span class="text-2xl font-extrabold tracking-tight">VALOREM</span>
              <span class="text-[11px] uppercase tracking-wider font-semibold bg-emerald-700/80 text-emerald-100 px-2 py-0.5 rounded-full border border-emerald-500/40">ODS 2 • 10 • 12</span>
            </div>
            <p class="text-xs text-emerald-200">Conexão solidária entre comércios e institutos sociais</p>
          </div>
        </div>

        <!-- Navegação Principal -->
        <nav class="flex flex-wrap gap-1.5 bg-emerald-950/60 p-1.5 rounded-xl border border-emerald-800">
          <button onclick="switchTab('vitrine')" id="tab-vitrine" class="nav-btn px-3.5 py-2 rounded-lg text-sm font-semibold transition flex items-center gap-2 bg-emerald-500 text-emerald-950 shadow">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
            Vitrine de Alimentos
          </button>
          <button onclick="switchTab('cadastrar')" id="tab-cadastrar" class="nav-btn px-3.5 py-2 rounded-lg text-sm font-semibold transition flex items-center gap-2 text-emerald-100 hover:bg-emerald-800/70">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
            Cadastrar Excedente
          </button>
          <button onclick="switchTab('reservas')" id="tab-reservas" class="nav-btn px-3.5 py-2 rounded-lg text-sm font-semibold transition flex items-center gap-2 text-emerald-100 hover:bg-emerald-800/70">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
            Minhas Reservas
            <span id="badgeReservas" class="bg-amber-400 text-slate-950 text-xs font-bold px-1.5 py-0.2 rounded-full">0</span>
          </button>
          <button onclick="switchTab('impacto')" id="tab-impacto" class="nav-btn px-3.5 py-2 rounded-lg text-sm font-semibold transition flex items-center gap-2 text-emerald-100 hover:bg-emerald-800/70">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
            Painel de Impacto
          </button>
        </nav>
      </div>
    </div>
  </header>

  <!-- Banner de Contexto Extensão -->
  <div class="bg-emerald-50 border-b border-emerald-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-2.5 flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs text-emerald-900">
      <div class="flex items-center gap-2">
        <span class="inline-block w-2 h-2 rounded-full bg-emerald-600 animate-pulse"></span>
        <span><strong>Protótipo Funcional (MVP):</strong> Excedentes alimentícios próprios para consumo com <strong>doação gratuita</strong> ou <strong>preço social</strong> exclusivo para ONGs e institutos.</span>
      </div>
      <div class="text-emerald-700 font-medium" id="headerCurrentDate"></div>
    </div>
  </div>

  <!-- Conteúdo Principal -->
  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <!-- ==================== ABA 1: VITRINE DE ALIMENTOS ==================== -->
    <section id="view-vitrine" class="space-y-6">
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-4">
        <div>
          <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900">Lotes Disponíveis para Resgate</h1>
          <p class="text-slate-600 text-sm mt-1">Selecione um lote publicado pelos estabelecimentos parceiros, confira a data limite de retirada e gere o comprovante da sua instituição.</p>
        </div>

        <!-- Filtros -->
        <div class="flex flex-col sm:flex-row gap-3">
          <div class="relative">
            <input type="text" id="searchInput" oninput="renderVitrine()" placeholder="Buscar alimento, loja ou bairro..." class="w-full sm:w-64 pl-9 pr-4 py-2 bg-white border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none" />
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-400 absolute left-3 top-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          </div>

          <select id="filterModality" onchange="renderVitrine()" class="px-3.5 py-2 bg-white border border-slate-300 rounded-xl text-sm font-medium text-slate-700 focus:ring-2 focus:ring-emerald-500 outline-none">
            <option value="all">Todas as Modalidades</option>
            <option value="doacao">Doação Gratuita (R$ 0,00)</option>
            <option value="social">Preço Social Superbaixo</option>
          </select>

          <select id="filterCategory" onchange="renderVitrine()" class="px-3.5 py-2 bg-white border border-slate-300 rounded-xl text-sm font-medium text-slate-700 focus:ring-2 focus:ring-emerald-500 outline-none">
            <option value="all">Todas as Categorias</option>
            <option value="Hortifrúti">Hortifrúti</option>
            <option value="Padaria">Padaria & Confeitaria</option>
            <option value="Mercearia">Mercearia & Grãos</option>
            <option value="Laticínios">Laticínios & Frios</option>
          </select>
        </div>
      </div>

      <!-- Grid de Cards -->
      <div id="vitrineGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"></div>
    </section>

    <!-- ==================== ABA 2: CADASTRAR EXCEDENTE (COMÉRCIO) ==================== -->
    <section id="view-cadastrar" class="hidden max-w-3xl mx-auto">
      <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="bg-emerald-900 px-6 py-5 text-white">
          <span class="text-xs font-semibold uppercase tracking-wider text-emerald-300">Área do Estabelecimento Parceiro</span>
          <h2 class="text-xl sm:text-2xl font-bold mt-1">Publicar Lote de Excedente Alimentício</h2>
          <p class="text-emerald-100 text-xs sm:text-sm mt-1">Cadastre alimentos próprios para consumo que não serão comercializados no fluxo tradicional, definindo a data limite e a janela de retirada.</p>
        </div>

        <form id="formCadastro" onsubmit="handleCreateItem(event)" class="p-6 space-y-5">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-bold uppercase text-slate-600 mb-1">Nome do Estabelecimento *</label>
              <input type="text" id="cadStore" required placeholder="Ex: Hortifrúti Vila Verde" class="w-full px-3.5 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-emerald-500 outline-none" />
            </div>
            <div>
              <label class="block text-xs font-bold uppercase text-slate-600 mb-1">Bairro / Endereço de Retirada *</label>
              <input type="text" id="cadAddress" required placeholder="Ex: Centro — Rua das Flores, 210" class="w-full px-3.5 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-emerald-500 outline-none" />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="sm:col-span-2">
              <label class="block text-xs font-bold uppercase text-slate-600 mb-1">Descrição do Alimento / Lote *</label>
              <input type="text" id="cadTitle" required placeholder="Ex: Caixa Mista de Legumes e Verduras Frescas" class="w-full px-3.5 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-emerald-500 outline-none" />
            </div>
            <div>
              <label class="block text-xs font-bold uppercase text-slate-600 mb-1">Categoria *</label>
              <select id="cadCategory" required class="w-full px-3.5 py-2.5 border border-slate-300 rounded-xl text-sm bg-white focus:ring-2 focus:ring-emerald-500 outline-none">
                <option value="Hortifrúti">Hortifrúti</option>
                <option value="Padaria">Padaria & Confeitaria</option>
                <option value="Mercearia">Mercearia & Grãos</option>
                <option value="Laticínios">Laticínios & Frios</option>
              </select>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-bold uppercase text-slate-600 mb-1">Peso Total Estimado (kg) *</label>
              <input type="number" id="cadWeight" required min="1" step="0.5" placeholder="Ex: 15" class="w-full px-3.5 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-emerald-500 outline-none" />
            </div>
            <div>
              <label class="block text-xs font-bold uppercase text-slate-600 mb-1">Modalidade de Repasse *</label>
              <select id="cadModality" onchange="togglePriceFields()" required class="w-full px-3.5 py-2.5 border border-slate-300 rounded-xl text-sm bg-white focus:ring-2 focus:ring-emerald-500 outline-none">
                <option value="doacao">Doação Gratuita (100% Solidária)</option>
                <option value="social">Preço Social Superbaixo (Custo Simbólico)</option>
              </select>
            </div>
          </div>

          <!-- Campos de Preço Social -->
          <div id="socialPriceBox" class="hidden bg-amber-50 border border-amber-200 rounded-xl p-4 space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold uppercase text-amber-900">Configuração de Preço Social</span>
              <span id="discountPreview" class="text-xs font-bold bg-amber-200 text-amber-950 px-2.5 py-0.5 rounded-full">Desconto: 0%</span>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">Valor Original de Mercado (R$) *</label>
                <input type="number" id="cadOriginalPrice" min="1" step="0.01" oninput="updateDiscountPreview()" placeholder="Ex: 120.00" class="w-full px-3.5 py-2 border border-amber-300 rounded-lg text-sm bg-white outline-none" />
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">Preço Social para ONG (R$) *</label>
                <input type="number" id="cadSocialPrice" min="0.5" step="0.01" oninput="updateDiscountPreview()" placeholder="Ex: 18.00" class="w-full px-3.5 py-2 border border-amber-300 rounded-lg text-sm bg-white outline-none" />
              </div>
            </div>
          </div>

          <!-- Datas e Janela de Retirada -->
          <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 space-y-4">
            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-700">Prazos, Janela de Retirada e Validade</h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">Data Limite para Retirada *</label>
                <input type="date" id="cadDeadlineDate" required class="w-full px-3.5 py-2 border border-slate-300 rounded-lg text-sm bg-white focus:ring-2 focus:ring-emerald-500 outline-none" />
                <p class="text-[11px] text-slate-500 mt-1">Data máxima em que o instituto pode retirar o lote.</p>
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">Data de Validade do Produto *</label>
                <input type="date" id="cadExpiryDate" required class="w-full px-3.5 py-2 border border-slate-300 rounded-lg text-sm bg-white focus:ring-2 focus:ring-emerald-500 outline-none" />
                <p class="text-[11px] text-slate-500 mt-1">Deve ser igual ou posterior à data limite de retirada.</p>
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">Horário Inicial da Janela *</label>
                <input type="time" id="cadWindowStart" value="14:00" required class="w-full px-3.5 py-2 border border-slate-300 rounded-lg text-sm bg-white focus:ring-2 focus:ring-emerald-500 outline-none" />
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">Horário Final da Janela *</label>
                <input type="time" id="cadWindowEnd" value="18:30" required class="w-full px-3.5 py-2 border border-slate-300 rounded-lg text-sm bg-white focus:ring-2 focus:ring-emerald-500 outline-none" />
              </div>
            </div>
          </div>

          <!-- Termo Sanitário -->
          <label class="flex items-start gap-3 p-3.5 bg-emerald-50/70 border border-emerald-200 rounded-xl cursor-pointer">
            <input type="checkbox" id="cadSanitaryCheck" required class="mt-1 w-4 h-4 text-emerald-600 rounded border-slate-300 focus:ring-emerald-500" />
            <span class="text-xs text-slate-700 leading-relaxed">
              <strong>Termo de Responsabilidade Sanitária:</strong> Declaro que os alimentos listados encontram-se armazenados em condições adequadas de higiene e temperatura, íntegros e próprios para o consumo humano dentro do prazo de validade informado.
            </span>
          </label>

          <div id="cadErrorMsg" class="hidden text-xs font-semibold text-red-700 bg-red-50 border border-red-200 px-4 py-2.5 rounded-xl"></div>

          <div class="flex justify-end gap-3 pt-2">
            <button type="button" onclick="switchTab('vitrine')" class="px-5 py-2.5 rounded-xl text-sm font-semibold text-slate-600 hover:bg-slate-100 transition">Cancelar</button>
            <button type="submit" class="px-6 py-2.5 rounded-xl text-sm font-bold bg-emerald-600 hover:bg-emerald-700 text-white shadow-sm transition">Publicar Lote na Vitrine</button>
          </div>
        </form>
      </div>
    </section>

    <!-- ==================== ABA 3: MINHAS RESERVAS ==================== -->
    <section id="view-reservas" class="hidden space-y-6">
      <div>
        <h2 class="text-2xl font-extrabold text-slate-900">Reservas e Comprovantes de Retirada</h2>
        <p class="text-sm text-slate-600 mt-1">Acompanhe os prazos limite de retirada, visualize o voucher oficial e confirme o recebimento dos alimentos pela instituição.</p>
      </div>

      <div id="reservasList" class="space-y-4"></div>
    </section>

    <!-- ==================== ABA 4: PAINEL DE IMPACTO (ODS) ==================== -->
    <section id="view-impacto" class="hidden space-y-8">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h2 class="text-2xl font-extrabold text-slate-900">Indicadores de Impacto Social e Ambiental</h2>
          <p class="text-sm text-slate-600 mt-1">Monitoramento em tempo real alinhado às metas brasileiras dos Objetivos de Desenvolvimento Sustentável (IPEA / Agenda 2030).</p>
        </div>
        <button onclick="resetDemoData()" class="self-start sm:self-auto px-4 py-2 bg-white hover:bg-slate-100 text-slate-700 border border-slate-300 rounded-xl text-xs font-semibold shadow-sm transition flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
          Restaurar Dados de Demonstração
        </button>
      </div>

      <!-- KPIs -->
      <div id="kpiGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5"></div>

      <!-- Distribuição e ODS -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-4">
          <h3 class="text-base font-bold text-slate-900">Volume Resgatado por Categoria Alimentar</h3>
          <div id="categoryBars" class="space-y-4"></div>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-4">
          <h3 class="text-base font-bold text-slate-900">Alinhamento com a Agenda 2030 (ONU / IPEA)</h3>
          <div class="space-y-3 text-xs text-slate-700">
            <div class="p-3.5 rounded-xl bg-amber-50 border border-amber-200">
              <div class="font-bold text-amber-900 text-sm">ODS 2 — Fome Zero e Agricultura Sustentável</div>
              <p class="mt-1">Amplia o acesso de famílias vulneráveis atendidas por ONGs a alimentos frescos, seguros e nutricionalmente adequados.</p>
            </div>
            <div class="p-3.5 rounded-xl bg-rose-50 border border-rose-200">
              <div class="font-bold text-rose-900 text-sm">ODS 10 — Redução das Desigualdades</div>
              <p class="mt-1">Reduz custos operacionais de cozinhas comunitárias e institutos sociais por meio de doações e preços simbólicos.</p>
            </div>
            <div class="p-3.5 rounded-xl bg-emerald-50 border border-emerald-200">
              <div class="font-bold text-emerald-900 text-sm">ODS 12 — Consumo e Produção Responsáveis</div>
              <p class="mt-1">Evita o descarte precoce de alimentos próprios para consumo no varejo local, diminuindo resíduos orgânicos.</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="bg-white border-t border-slate-200 mt-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-slate-500">
      <span><strong>VALOREM</strong> — Projeto de Extensão Universitária • Cocriação e Desenvolvimento de Projetos</span>
      <span>Segurança Alimentar, Tecnologia Social e Redução do Desperdício</span>
    </div>
  </footer>

  <!-- ==================== MODAL DE RESERVA (ONG / INSTITUTO) ==================== -->
  <div id="reserveModal" class="hidden fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-40 flex items-center justify-center p-4 overflow-y-auto">
    <div class="bg-white rounded-2xl max-w-lg w-full shadow-2xl border border-slate-200 overflow-hidden my-8">
      <div class="bg-emerald-900 px-6 py-4 text-white flex items-center justify-between">
        <div>
          <span class="text-[11px] uppercase tracking-wider text-emerald-300 font-semibold">Solicitação de Resgate Institucional</span>
          <h3 class="text-lg font-bold">Reservar Lote de Alimentos</h3>
        </div>
        <button onclick="closeReserveModal()" class="text-emerald-200 hover:text-white p-1">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>

      <form onsubmit="handleConfirmReserve(event)" class="p-6 space-y-4">
        <div id="modalItemSummary" class="bg-slate-50 border border-slate-200 rounded-xl p-4 text-xs space-y-1.5"></div>

        <div>
          <label class="block text-xs font-bold uppercase text-slate-600 mb-1">Nome da ONG / Instituto Social *</label>
          <input type="text" id="resOrgName" required placeholder="Ex: Instituto Mãos Solidárias" class="w-full px-3.5 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-emerald-500 outline-none" />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-bold uppercase text-slate-600 mb-1">CNPJ ou Registro Social *</label>
            <input type="text" id="resOrgDoc" required placeholder="00.000.000/0001-00" class="w-full px-3.5 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-emerald-500 outline-none" />
          </div>
          <div>
            <label class="block text-xs font-bold uppercase text-slate-600 mb-1">Telefone / WhatsApp *</label>
